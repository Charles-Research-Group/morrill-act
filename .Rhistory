library(ggplot2)
library(gapminder)
library(viridis)
library(gganimate)
library(gifski)
gapminder_data <- gapminder
ggplot(gapminder_data)+
geom_point(aes(x=gdpPercap, y=lifeExp, size=pop, color=continent,
fill=continent, group=country), alpha=0.7)+
scale_size_continuous(label=scales::comma, range=c(1,20))+
scale_x_continuous(label=scales::comma, trans="log2")+
theme_minimal()+
scale_fill_viridis(option="A", discrete=TRUE)+
scale_color_viridis(option="A", discrete=TRUE)+
labs(
title="GDP Per Capita and Life Expectancy Over 50+ Years",
subtitle= "Year: {frame_time}",
size="Population",
fill="Continent",
x="GDP Per Capita",
y="Life Expectancy",
)+
guides(color="none")+
transition_time(year)
animation ggplot(gapminder_data)+
animate(animation, fps=10, duration=30, end_pause=50)
